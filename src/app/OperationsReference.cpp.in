// Generated from docs/OPERATIONS.md and docs/EXPRESSIONS.md when CMake configures (see
// src/CMakeLists.txt): the references the MCP server hands to AI assistants
// (get_operations_reference, get_expressions_reference).

namespace bemotion {

extern const char* const kOperationsReference;
const char* const kOperationsReference = R"bmref(@BEMOTION_OPS_REFERENCE@)bmref";
extern const char* const kExpressionsReference;
const char* const kExpressionsReference = R"bmref(@BEMOTION_EXPRESSIONS_REFERENCE@)bmref";

} // namespace bemotion
